# El servidor entra a Postgres con este rol. En producción tiene que ser toka_app:
# sin DDL, sin BYPASSRLS, y por lo tanto sujeto a las policies que aíslan cada
# household dentro de la base (ver db/roles.sql y la migración 002).
DATABASE_URL=postgres://toka_app:toka@localhost:5432/toka?sslmode=disable

# Rol con el que se corren migraciones y seed: necesita ser dueño de las tablas.
# Si se omite, se usa DATABASE_URL — cómodo en local, incorrecto en producción.
DATABASE_MIGRATION_URL=postgres://toka:toka@localhost:5432/toka?sslmode=disable

# Contra un host remoto, sslmode=disable hace que el servidor se niegue a arrancar.
# En la nube corresponde:
#   ...?sslmode=verify-full&sslrootcert=/ruta/al/ca.crt
# verify-full es el único modo que además comprueba que el certificado corresponde
# al host: con sslmode=require el tráfico va cifrado pero contra quien sea.

PORT=3000

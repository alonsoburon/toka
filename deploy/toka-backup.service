[Unit]
Description=Respaldo de toka.db (local verificado + R2)

[Service]
Type=oneshot
# El volumen del contenedor rootless es de un uid remapeado (110000 en el host): solo se
# puede leer/escribir bien desde el user namespace de podman, de ahí `podman unshare`.
# Requiere el paquete sqlite3 en el host.
Environment=TOKA_DB=%h/.local/share/containers/storage/volumes/toka-data/_data/toka.db
Environment=TOKA_BACKUP_DIR=%h/backups/toka
Environment=TOKA_BACKUP_UPLOAD=%h/apps/toka/deploy/upload-r2.sh
ExecStart=/usr/bin/podman unshare %h/apps/toka/deploy/backup-toka.sh
